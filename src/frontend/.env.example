# Copy to .env.local for local overrides. Read at build time by Vite.

# Public URL of the site (no trailing slash needed). Enables <link rel="canonical">,
# og:url, absolute share-image URLs, sitemap.xml and the Sitemap line in robots.txt.
VITE_SITE_URL=

# API target for the dev/preview proxy
VITE_API_URL=http://127.0.0.1:8000

# Optional map tiles (OpenStreetMap's own tiles are fine for low traffic only)
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=
