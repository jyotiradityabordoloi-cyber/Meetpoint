# Copy to .env and fill in. Never commit .env.

# Server-side key for Routes API, Places API (New) and Geocoding API.
# Empty = travel times are estimates, no venues, no address search.
GOOGLE_MAPS_API_KEY=

# SQLite for local dev; PostgreSQL in Docker / production, e.g.
# postgresql+psycopg://meetpoint:meetpoint@localhost:5432/meetpoint
DATABASE_URL=sqlite:///./meetpoint.db

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Group limits
MIN_MEMBERS=2
MAX_MEMBERS=25
MAX_GROUP_SPREAD_KM=100

# Candidate zone ring: radius = clamp(RATIO x group spread, MIN_KM, MAX_KM)
CANDIDATE_RADIUS_RATIO=0.25
CANDIDATE_RADIUS_MIN_KM=0.5
CANDIDATE_RADIUS_MAX_KM=10
TOP_ZONES=3

# Fairness score S = W_MAX*max + W_STD*std + W_MEAN*mean (minutes)
W_MAX=0.5
W_STD=0.3
W_MEAN=0.2

# Venue search
VENUE_RADIUS_STEPS=800,1500,3000
VENUE_POOL_SIZE=10
VENUES_TO_RETURN=5

# Estimates when routing is unavailable
FALLBACK_SPEED_KMH=DRIVE=30,TWO_WHEELER=28,TRANSIT=22,BICYCLE=15,WALK=4.8
FALLBACK_DETOUR_FACTOR=1.3

# Privacy and abuse
GROUP_RETENTION_DAYS=30
PURGE_ON_STARTUP=true
RATE_LIMIT_PER_MINUTE=10
